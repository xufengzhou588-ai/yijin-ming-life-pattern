{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/bazi-annual-outlook-v1.schema.json",
  "title": "BaziAnnualOutlook v1",
  "type": "object",
  "required": ["schema_version", "model_version", "core_schema_version", "trait_schema_version", "years"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "model_version": { "type": "string" },
    "core_schema_version": { "const": "1.0.0" },
    "trait_schema_version": { "const": "1.0.0" },
    "years": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["year", "pillar", "theme_element", "scores", "focus_key", "caution_key", "confidence", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "year": { "type": "integer" },
          "pillar": { "type": "string", "minLength": 2, "maxLength": 2 },
          "theme_element": { "enum": ["wood", "fire", "earth", "metal", "water"] },
          "scores": {
            "type": "object",
            "required": ["career", "wealth", "relationship", "stability"],
            "additionalProperties": false,
            "properties": {
              "career": { "type": "integer", "minimum": 0, "maximum": 100 },
              "wealth": { "type": "integer", "minimum": 0, "maximum": 100 },
              "relationship": { "type": "integer", "minimum": 0, "maximum": 100 },
              "stability": { "type": "integer", "minimum": 0, "maximum": 100 }
            }
          },
          "focus_key": {
            "enum": ["career_progress", "wealth_boundaries", "relationship_communication", "execution_rhythm"]
          },
          "caution_key": {
            "enum": ["avoid_scattered_goals", "avoid_unbounded_input", "avoid_unspoken_expectations", "avoid_overcommitment"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 0.72 },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
