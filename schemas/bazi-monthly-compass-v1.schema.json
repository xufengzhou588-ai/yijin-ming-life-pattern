{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/bazi-monthly-compass-v1.schema.json",
  "title": "BaziMonthlyCompass v1",
  "type": "object",
  "required": ["schema_version", "model_version", "core_schema_version", "trait_schema_version", "start_month", "months", "calculation_evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "model_version": { "const": "monthly-compass-v1" },
    "core_schema_version": { "const": "1.0.0" },
    "trait_schema_version": { "const": "1.0.0" },
    "start_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "months": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/month" }
    },
    "calculation_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/calculationEvidence" }
    }
  },
  "$defs": {
    "month": {
      "type": "object",
      "required": ["year", "month", "pillar", "stem_element", "branch_element", "yin_yang", "scores", "focus_key", "boundary_key", "experiment_key", "reflection_key", "mark", "confidence", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "pillar": { "type": "string", "minLength": 2, "maxLength": 2 },
        "stem_element": { "$ref": "#/$defs/element" },
        "branch_element": { "$ref": "#/$defs/element" },
        "yin_yang": { "enum": ["yin", "yang"] },
        "scores": {
          "type": "object",
          "required": ["career", "wealth", "relationship", "stability"],
          "additionalProperties": false,
          "properties": {
            "career": { "$ref": "#/$defs/score" },
            "wealth": { "$ref": "#/$defs/score" },
            "relationship": { "$ref": "#/$defs/score" },
            "stability": { "$ref": "#/$defs/score" }
          }
        },
        "focus_key": { "enum": ["make_visible_progress", "test_before_expanding", "clarify_expectations", "build_repeatable_rhythm"] },
        "boundary_key": { "enum": ["limit_scattered_goals", "set_cost_and_exit_limits", "replace_guessing_with_requests", "protect_recovery_and_focus"] },
        "experiment_key": { "enum": ["ship_one_visible_result", "run_one_small_validation", "hold_one_clear_conversation", "repeat_one_weekly_system"] },
        "reflection_key": { "enum": ["reflect_career", "reflect_wealth", "reflect_relationship", "reflect_stability"] },
        "mark": {
          "type": "object",
          "required": ["glyph", "palette_key", "meaning_key", "pattern_key", "collection_id"],
          "additionalProperties": false,
          "properties": {
            "glyph": { "type": "string", "minLength": 1 },
            "palette_key": { "enum": ["jade", "coral", "gold", "silver", "cyan"] },
            "meaning_key": { "enum": ["growth", "clarity", "balance", "discernment", "adaptation"] },
            "pattern_key": { "enum": ["expanding", "gathering"] },
            "collection_id": { "type": "string" }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 0.68 },
        "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "calculationEvidence": {
      "type": "object",
      "required": ["id", "type", "description", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "monthly_pillar_proxy" },
        "description": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "element": { "enum": ["wood", "fire", "earth", "metal", "water"] },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 }
  }
}
